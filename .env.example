# ============ ต้องตั้ง (ขั้นต่ำเพื่อให้เว็บใช้งานได้) ============
# โดเมนเว็บ เช่น https://flexozy.site   (ไม่ตั้งก็ได้ ระบบจะใช้โดเมนที่เข้าจริง)
SITE_URL=https://flexozy.site
# สุ่มสตริงยาวๆ:  openssl rand -hex 32   (ใช้เซ็น cookie ล็อกอิน ห้ามเปิดเผย)
SESSION_SECRET=
# Discord Developer Portal > OAuth2  (Redirect: SITE_URL/api/auth/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord ID ของเจ้าของ/แอดมินหลัก (หลายคนคั่นด้วย ,)  แอดมินคนอื่นเพิ่มได้ในหน้า Admin
ADMIN_IDS=

# ============ ฐานข้อมูล ============
# Upstash Redis / Vercel KV  (ถ้าไม่ตั้ง จะเก็บลงไฟล์ .data — ใช้ได้เฉพาะ VPS/เครื่องตัวเอง ห้ามใช้บน Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (หรือชื่อ UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN ก็ได้)

# ============ เพิ่มคนเข้าเซิร์ฟเวอร์ Discord ตอนล็อกอิน ============
# ID เซิร์ฟเวอร์ (หรือตั้งในหน้า Admin > ตั้งค่าเว็บ ก็ได้)
DISCORD_GUILD_ID=
# Bot Token จาก Developer Portal > Bot  (บอทต้องอยู่ในเซิร์ฟเวอร์และมีสิทธิ์ Create Invite)
DISCORD_BOT_TOKEN=

# ============ ป้องกันบอท (ไม่บังคับ แต่แนะนำ) ============
# Cloudflare Turnstile — ไม่ตั้ง = ข้าม captcha (ระบบ PoW และตัวกันอื่นยังทำงาน)
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ============ อื่นๆ ============
# (ไม่บังคับ) สำหรับบอท Discord ของคุณเรียก /api/bot
BOT_SECRET=
# ชื่อเว็บ/ลิงก์ Discord/สลัก demo เริ่มต้น (แก้ต่อได้ในหน้า Admin ไม่ต้อง redeploy)
NEXT_PUBLIC_SITE_NAME=Flexozy
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_DEMO_SLUG=demo
