# ===== จำเป็น =====
# Postgres connection string (Vercel Storage > Neon / Supabase / ที่อื่นก็ได้)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# บัญชีแอดมินตัวแรก (สร้างอัตโนมัติเมื่อเปิดเว็บครั้งแรก ถ้ายังไม่มีแอดมินในระบบ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ตั้งรหัสผ่านยาวๆอย่างน้อย8ตัว

# ===== ไม่จำเป็น =====
# ลิงก์เข้าหลังบ้าน = https://โดเมน/<ADMIN_PATH> (/admin ตรงๆ จะขึ้น 404) — แนะนำให้ตั้งเองเป็นคำสุ่มยาวๆ (a-z 0-9 - _ 6–40 ตัว)
ADMIN_PATH=fx-panel-k7q2m9x4
# 1 = ใส่สินค้าตัวอย่าง ตอนสร้างฐานข้อมูลครั้งแรก (ค่าเริ่มต้น 1)
SEED_DEMO=1
# 1 = ใส่สต็อกตัวอย่างปลอม (DEMO-xxxx) เพื่อดูหน้าตาเว็บ  **ห้ามเปิดตอนขายจริง**
SEED_DEMO_STOCK=0

# TrueMoney Wallet: เบอร์ TrueMoney ของร้าน (10 หลัก) ระบบรับซองอั่งเปาเข้าเบอร์นี้อัตโนมัติ
TRUEMONEY_MOBILE=

# ===== ล็อกอินด้วย Discord (ไม่จำเป็น — ไม่ตั้งค่า = ซ่อนปุ่ม) =====
# สร้างแอปที่ https://discord.com/developers/applications → OAuth2
#  - เพิ่ม Redirects:  https://โดเมนของคุณ/api/auth/discord/callback   (และ http://localhost:3000/api/auth/discord/callback สำหรับทดสอบ)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# โดเมนจริงของเว็บ (ใช้ทำ redirect URI และลิงก์พรีวิว) เช่น https://flexozy.site
SITE_URL=https://flexozy.site
# (ไม่บังคับ) บังคับ redirect URI เอง ถ้าไม่ตั้งจะใช้ SITE_URL + /api/auth/discord/callback
DISCORD_REDIRECT_URI=

# ===== ตรวจสอบความปลอดภัยก่อนล็อกอิน/สมัคร (แคปช่า) =====
# ไม่ตั้ง = ใช้ระบบตรวจของเว็บเอง (Flexozy Shield) ทำงานได้ทันที
# แนะนำให้ใช้ Cloudflare Turnstile (ฟรี) แข็งแรงกว่า: https://dash.cloudflare.com → Turnstile → Add widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# (ไม่บังคับ) คีย์ลับสำหรับเซ็นโทเคน ถ้าไม่ตั้งจะสร้างจาก DATABASE_URL + ADMIN_PASSWORD
CAPTCHA_SECRET=
# 1 = ปิดแคปช่า ใช้ตอนรัน e2e เท่านั้น ห้ามเปิดตอนขายจริง
CAPTCHA_DISABLED=0

# ===== Discord Bot เชื่อมเว็บ (ให้บอทเติมเงิน/ซื้อคีย์ผ่านเว็บ) =====
# รหัสลับร่วมระหว่างเว็บกับบอท (ยาว 16+ ตัวอักษร) ต้องตั้งค่าเดียวกันทั้งสองฝั่ง ไม่ตั้ง = ปิดช่องทางบอท
BOT_API_SECRET=

# ===== TrueMoney ถูกบล็อก? (ตอบกลับข้อมูลไม่ถูกต้อง / HTTP 403) =====
# ถ้า Vercel ถูก TrueMoney/Cloudflare บล็อก ให้ตั้ง relay บนเซิร์ฟเวอร์ไทย แล้วใส่ URL + รหัสลับ (ปกติไม่ต้องตั้ง)
# TRUEMONEY_BASE_URL=https://relay.example.com
# TRUEMONEY_RELAY_KEY=

# ===== API key สำหรับบอท: ไม่ต้องตั้งในนี้ก็ได้ =====
# สร้างได้ที่ /admin → API Key (แนะนำ) แล้วใส่ในไฟล์ .env ของบอทเป็น BOT_API_SECRET
# BOT_API_SECRET ด้านบน (ถ้าตั้ง) ยังใช้ได้เหมือนเดิม

# ===== Hub: ร้านค้าบอท Discord สำหรับบุคคลทั่วไป (อยู่บนโดเมนหลักเดียวกัน ไม่ต้องเพิ่มโดเมน) =====
#   หน้าล็อกอิน:  https://flexozy.site/shop/login
#   แดชบอร์ด:     https://flexozy.site/shop/dashboard
#   หน้าร้าน:     https://flexozy.site/<ชื่อ Discord ของเจ้าของร้าน>
# Redirect ใน Discord Developer Portal ใช้ตัวเดียวกับเว็บหลัก: https://flexozy.site/api/auth/discord/callback
# (ไม่ต้องเพิ่ม Redirect ใหม่) — โดเมนเก่า shop.flexozy.site ถ้ายังชี้มา จะถูกเด้งมาโดเมนหลักอัตโนมัติ; ตั้ง HUB_HOST= (ว่าง) เพื่อปิดการเด้ง
HUB_HOST=shop.flexozy.site
# Client ID ของแอปบอท (ใช้สร้างลิงก์เชิญบอทในแดชบอร์ด) ไม่ตั้ง = ใช้ DISCORD_CLIENT_ID
BOT_CLIENT_ID=
# ค่าธรรมเนียมแพลตฟอร์ม % ที่หักจากยอดขายของเจ้าของร้าน (0-50) ค่าเริ่มต้น 0
SHOP_FEE_PERCENT=0

# ===== Hub v2 =====
# Client ID ของบอทร้านค้า (ใช้สร้างลิงก์เชิญบอท) — ค่าเริ่มต้นในโค้ดคือ 1535495556460318851
BOT_CLIENT_ID=1535495556460318851
# โทเคนบอท (ฝั่งเว็บใช้แค่อ่าน: เช็คว่าบอทอยู่ในเซิร์ฟเวอร์ไหม, ดึงรายชื่อห้อง และอีโมจิ/อีโมจิเคลื่อนไหวของเซิร์ฟเวอร์) ไม่ตั้ง = เลือกอีโมจิจากเซิร์ฟเวอร์ไม่ได้
DISCORD_BOT_TOKEN=

# ===== หน้า /happybirthday/warisara =====
# ลิงก์ Discord webhook สำหรับแจ้งเตือนว่ามีคนเปิดหน้า (ไม่ตั้ง = ไม่แจ้งเตือน หน้าเว็บยังใช้ได้ปกติ)
BDAY_DISCORD_WEBHOOK=
